{
  "name": "owlsift",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@9.2.0",
  "main": "electron-build/main.js",
  "scripts": {
    "dev": "nuxt dev",
    "test:workspace": "tsc -p tsconfig.electron.json && node --test tests/workspace-files.test.cjs",
    "test:scan": "tsc -p tsconfig.electron.json && node --test tests/document-scan.test.cjs",
    "generate": "nuxt generate && node scripts/prepare-static-assets.cjs",
    "prebuild:electron": "node scripts/ensure-release-database.cjs",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/prepare-electron-build.cjs",
    "electron:dev": "npm run build:electron && electron electron-build/main.js --no-sandbox",
    "electron:build": "npm run generate && npm run build:electron && electron-builder --publish never",
    "electron:build:quick": "node scripts/quick-electron-build.cjs",
    "electron:build:zip": "node scripts/build-zip.cjs"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@formkit/auto-animate": "^0.10.0",
    "@nuxt/ui": "^4.11.2",
    "@nuxtjs/color-mode": "^4.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.0.0",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.0",
    "vue-tsc": "^2.0.0"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "better-sqlite3": "^13.0.3",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299"
  },
  "build": {
    "appId": "com.localmind.desktop",
    "productName": "OwlSift",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "electron-build/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}",
      "icon": "assets/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icons/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icons/icon.png"
    },
    "extraResources": [
      {
        "from": ".output/release-resources/localmind.db",
        "to": "database/localmind.db"
      },
      {
        "from": ".output/public",
        "to": "app"
      }
    ]
  },
  "description": "Local document workspace with AI analysis",
  "author": "Nero656"
}
