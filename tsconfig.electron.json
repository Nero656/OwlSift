{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./.electron-tsc",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", ".nuxt", ".output", "app/**/*"]
}
